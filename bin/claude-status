#!/bin/sh
# tmux-claude-status — publish Claude Code session state as tmux options.
#
# This is the STATE half. It knows nothing about how the badge is drawn.
#
# State is stored PER PANE in @claude_pane_status, then aggregated to the window
# in @claude_status for the renderer. Two Claude sessions in two panes of one
# window therefore no longer overwrite each other; the window shows whichever
# pane is most in need of attention.
#
# Invoked by Claude Code hooks:
#   UserPromptSubmit    -> prompt      : a turn started              -> running
#   Notification        -> ask         : blocked on the user         -> question
#   PreToolUse          -> ask         : AskUserQuestion is opening   -> question
#   PreToolUse          -> plan        : ExitPlanMode is opening      -> plan
#   PostToolUse         -> busy        : a tool completed            -> retires question
#   PostToolUseFailure  -> busy        : a tool failed               -> retires question
#   Stop                -> stop        : turn finished               -> shells | done
#   StopFailure         -> stop        : turn died (API error etc.)  -> shells | done
#   SubagentStart       -> agent-start : a background agent began
#   SubagentStop        -> agent-stop  : a background agent finished
#   SessionStart        -> start       : new session                 -> repair this pane
#   SessionEnd          -> end         : session gone                -> clear this pane
#
# States: running | question | plan | error | shells | loop | done  (unset = idle)
#
# Exits 0 and does nothing outside tmux, so it's safe to wire unconditionally.
# Argument validation happens BEFORE that guard, so a typo is caught everywhere.

case "${1:-}" in
  prompt|clear|ask|plan|busy|stop|done|failed|end|unset|start|agent-start|agent-stop|loop-arm|cron-add|cron-del|state) ;;
  *)
    echo "usage: claude-status {prompt|ask|plan|busy|stop|failed|end|start|agent-start|agent-stop|loop-arm|cron-add|cron-del|state}" >&2
    exit 2
    ;;
esac

[ -n "$TMUX" ] && [ -n "$TMUX_PANE" ] || exit 0

TMUX_BIN="${CLAUDE_STATUS_TMUX_BIN:-}"
[ -n "$TMUX_BIN" ] || TMUX_BIN="/opt/homebrew/bin/tmux"   # macOS (Homebrew)
[ -x "$TMUX_BIN" ] || TMUX_BIN="/usr/local/bin/tmux"      # macOS (Intel Homebrew)
[ -x "$TMUX_BIN" ] || TMUX_BIN="/usr/bin/tmux"            # Linux
[ -x "$TMUX_BIN" ] || TMUX_BIN="tmux"                     # fall back to PATH

# ---------------------------------------------------------------- pane state --
pane_set()   { "$TMUX_BIN" set-option -p -t "$TMUX_PANE" @claude_pane_status "$1" 2>/dev/null; }
pane_unset() { "$TMUX_BIN" set-option -p -t "$TMUX_PANE" -u @claude_pane_status 2>/dev/null; }
pane_get()   { "$TMUX_BIN" display-message -p -t "$TMUX_PANE" '#{@claude_pane_status}' 2>/dev/null; }

# --------------------------------------------------------------- agent count --
# Background agents run INSIDE the claude process, so they have no child process
# for bg_shell_count to find. They're tracked with a counter instead, reset by
# SessionStart so a crash mid-agent can't leave it stuck above zero forever.
agents_get() {
  n=$("$TMUX_BIN" display-message -p -t "$TMUX_PANE" '#{@claude_agents}' 2>/dev/null)
  case "$n" in ''|*[!0-9]*) echo 0 ;; *) echo "$n" ;; esac
}
agents_set() { "$TMUX_BIN" set-option -p -t "$TMUX_PANE" @claude_agents "$1" 2>/dev/null; }

# ------------------------------------------------------------ loop tracking --
# A looping session is idle between iterations but is NOT done: it re-enqueues
# its own next turn. Two mechanisms, both of which resume THIS session:
#   ScheduleWakeup — /loop dynamic mode, called once per iteration
#   CronCreate     — /loop <interval> and /schedule. Cron jobs are session-only
#                    and fire while the REPL is idle, so a live job means this
#                    session wakes itself up again.
num() { case "$1" in ''|*[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }
wake_get()  { num "$("$TMUX_BIN" display-message -p -t "$TMUX_PANE" '#{@claude_wake}' 2>/dev/null)"; }
wake_set()  { "$TMUX_BIN" set-option -p -t "$TMUX_PANE" @claude_wake "$1" 2>/dev/null; }
crons_get() { num "$("$TMUX_BIN" display-message -p -t "$TMUX_PANE" '#{@claude_crons}' 2>/dev/null)"; }
crons_set() { "$TMUX_BIN" set-option -p -t "$TMUX_PANE" @claude_crons "$1" 2>/dev/null; }
looping()   { [ "$(wake_get)" -gt 0 ] || [ "$(crons_get)" -gt 0 ]; }

# ScheduleWakeup ends a loop by passing stop:true, so the hook has to read the
# tool input rather than just the tool name.
wakeup_is_stop() {
  payload=$(cat 2>/dev/null || true)
  [ -n "$payload" ] || return 1
  if command -v python3 >/dev/null 2>&1; then
    printf '%s' "$payload" | python3 -c 'import json,sys
try: d = json.load(sys.stdin)
except Exception: sys.exit(1)
sys.exit(0 if (d.get("tool_input") or {}).get("stop") is True else 1)' 2>/dev/null && return 0
    return 1
  fi
  printf '%s' "$payload" | grep -Eq '"stop"[[:space:]]*:[[:space:]]*true'
}

# --------------------------------------------------------- background shells --
# Direct zsh/bash/sh children of THIS pane's claude process, minus this hook's
# own shell (found by walking our own ancestry). MCP servers (node/python) and
# caffeinate are long-lived but don't match the shell-name filter.
#
# ps, not pgrep: pgrep -P returns nothing from inside a hook's execution
# context — silently, which reads exactly like "no background shells".
bg_shell_count() {
  pane_pid=$("$TMUX_BIN" display-message -p -t "$TMUX_PANE" '#{pane_pid}' 2>/dev/null)
  [ -n "$pane_pid" ] || { echo 0; return; }
  case "$(ps -o comm= -p "$pane_pid" 2>/dev/null)" in
    *claude) claude_pid=$pane_pid ;;
    *) claude_pid=$(ps -eo pid,ppid,comm | awk -v pp="$pane_pid" '$2==pp && $3 ~ /claude$/ {print $1; exit}') ;;
  esac
  [ -n "$claude_pid" ] || { echo 0; return; }
  anc=" $$ "; p=$$; i=0
  while [ "$i" -lt 10 ]; do
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' '); [ -n "$p" ] || break
    anc="$anc$p "; [ "$p" = "$claude_pid" ] && break; i=$((i+1))
  done
  n=0
  for c in $(ps -eo pid,ppid,comm | awk -v cp="$claude_pid" '$2==cp && $3 ~ /\/(zsh|bash|sh)$|^(zsh|bash|sh)$/ {print $1}'); do
    case "$anc" in *" $c "*) ;; *) n=$((n+1)) ;; esac
  done
  echo "$n"
}

# Is anything still working for this pane after the turn ended?
still_working() {
  [ "$(bg_shell_count)" -gt 0 ] && return 0
  [ "$(agents_get)" -gt 0 ] && return 0
  return 1
}

# ------------------------------------------------------------- aggregation ---
# Window badge = the pane most in need of attention.
#   question (needs you) > done (ready to read) > running > shells
rank() {
  case "$1" in
    question) echo 7 ;;
    error)    echo 6 ;;
    plan)     echo 5 ;;
    done)     echo 4 ;;
    running)  echo 3 ;;
    shells)   echo 2 ;;
    loop)     echo 1 ;;
    *)        echo 0 ;;
  esac
}

ack_get()   { "$TMUX_BIN" display-message -p -t "$TMUX_PANE" '#{@claude_ack}' 2>/dev/null; }
ack_clear() { "$TMUX_BIN" set-option -w -t "$TMUX_PANE" -u @claude_ack 2>/dev/null; }

# Recompute the window option from every pane in this pane's window.
#
# @claude_ack is set by the renderer's visit hook. While it's set, already-seen
# "done" states are suppressed, so visiting a window can't be undone by an
# unrelated pane later writing its own state. A fresh "done" clears the ack.
recompute() {
  acked=$(ack_get)
  best=""; best_rank=0
  for s in $("$TMUX_BIN" list-panes -t "$TMUX_PANE" -F '#{@claude_pane_status}' 2>/dev/null); do
    [ "$s" = done ] && [ -n "$acked" ] && continue
    r=$(rank "$s")
    if [ "$r" -gt "$best_rank" ]; then best_rank=$r; best=$s; fi
  done
  if [ -z "$best" ]; then
    "$TMUX_BIN" set-option -w -t "$TMUX_PANE" -u @claude_status 2>/dev/null
  else
    "$TMUX_BIN" set-option -w -t "$TMUX_PANE" @claude_status "$best" 2>/dev/null
  fi
}

redraw() {
  for c in $("$TMUX_BIN" list-clients -F '#{client_tty}' 2>/dev/null); do
    "$TMUX_BIN" refresh-client -S -t "$c" 2>/dev/null
  done
}

case "$1" in
  prompt|clear)
    pane_set running
    ;;
  ask)
    # Live state, not an unread-event flag: set it even on the active window so
    # it stays accurate the moment you switch away from the dialog.
    pane_set question
    ;;
  plan)
    # A plan is written and waiting for approval. Distinct from question: you're
    # reading a proposal, not answering a prompt. Same lifecycle though.
    pane_set plan
    ;;
  busy)
    # PostToolUse fires on every tool call, so bail on the first read unless
    # there's something waiting on the user to retire. Approving or rejecting a
    # plan completes ExitPlanMode, which is what lands here.
    case "$(pane_get)" in question|plan) ;; *) exit 0 ;; esac
    pane_set running
    ;;
  stop|done)
    # Set the badge even when this window is active. Being parked in a window is
    # not the same as having read what landed in it.
    if still_working; then
      pane_set shells
    elif looping; then
      # Idle between iterations, but the session re-enqueues itself. Reporting
      # "done" here is the whole bug: nothing is ready and nothing needs you.
      pane_set loop
    else
      pane_set done
      ack_clear          # a fresh answer un-acknowledges the window
    fi
    ;;
  failed)
    # StopFailure fires INSTEAD of Stop when an API error ended the turn. There
    # is no answer to read, so this must not look like done.
    pane_set error
    ack_clear
    ;;
  loop-arm)
    if wakeup_is_stop; then wake_set 0; else wake_set 1; fi
    ;;
  cron-add)
    crons_set $(( $(crons_get) + 1 ))
    ;;
  cron-del)
    n=$(crons_get); [ "$n" -gt 0 ] && n=$((n - 1))
    crons_set "$n"
    ;;
  agent-start)
    agents_set $(( $(agents_get) + 1 ))
    ;;
  agent-stop)
    n=$(agents_get); [ "$n" -gt 0 ] && n=$((n - 1))
    agents_set "$n"
    # The turn already ended, so nothing else will re-evaluate: promote ⏳ to ✅
    # here once the last agent is gone and no shells remain.
    if [ "$(pane_get)" = shells ] && ! still_working; then
      pane_set done
      ack_clear
    fi
    ;;
  start)
    # A new session owns this pane. Clear whatever the previous one left behind
    # after an unclean exit — and only this pane, so a sibling Claude keeps its.
    pane_unset
    agents_set 0; wake_set 0; crons_set 0
    ;;
  end|unset)
    pane_unset
    agents_set 0; wake_set 0; crons_set 0
    ;;
  state)
    pane_get; exit 0
    ;;
esac

recompute
redraw
exit 0
